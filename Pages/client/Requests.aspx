<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
    <main class="py-14"><div class="flex items-end justify-between border-b border-slate-200 pb-9"><div><p class="text-sm font-semibold text-blue-600">COMMUNITY BOARD</p><h1 class="mt-2 text-4xl font-bold tracking-tight">Project requests</h1><p class="mt-3 text-slate-600">Tell the community what you need built.</p></div><a class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white hover:bg-blue-700" href="#post-request">Post a request</a></div><div class="mt-8 grid grid-cols-[1fr_280px] gap-10"><section class="space-y-5"><article class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-slate-200"><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-blue-600">WEB · REACT</p><h2 class="mt-2 text-xl font-bold">Need an e-commerce storefront</h2></div><span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">₹15,000 budget</span></div><p class="mt-4 leading-7 text-slate-600">Looking for a developer to turn a complete Figma design into a fast, accessible storefront with payments and a simple product manager.</p><div class="mt-6 flex items-center justify-between text-sm"><span class="text-slate-500">Posted 2 hours ago · 12 developers interested</span><a class="font-semibold text-blue-600 hover:text-blue-800" href="<%= ResolveUrl("~/Pages/seller/SellerPitch.aspx") %>">Show interest &rarr;</a></div></article><article class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-slate-200"><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-blue-600">MOBILE · FLUTTER</p><h2 class="mt-2 text-xl font-bold">Fitness habit tracker</h2></div><span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">₹8,000 budget</span></div><p class="mt-4 leading-7 text-slate-600">I need a small mobile app to track workouts, streaks, and weekly goals. Clean visual design and offline support are essential.</p><div class="mt-6 flex items-center justify-between text-sm"><span class="text-slate-500">Posted yesterday · 8 developers interested</span><a class="font-semibold text-blue-600 hover:text-blue-800" href="<%= ResolveUrl("~/Pages/seller/SellerPitch.aspx") %>">Show interest &rarr;</a></div></article><article class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-slate-200"><div class="flex items-start justify-between"><div><p class="text-sm font-semibold text-blue-600">PYTHON · AUTOMATION</p><h2 class="mt-2 text-xl font-bold">Automate weekly reporting</h2></div><span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">₹5,000 budget</span></div><p class="mt-4 leading-7 text-slate-600">Create a script that collects monthly sales data, creates a formatted report, and sends it to our team every Monday morning.</p><div class="mt-6 flex items-center justify-between text-sm"><span class="text-slate-500">Posted 2 days ago · 5 developers interested</span><a class="font-semibold text-blue-600 hover:text-blue-800" href="<%= ResolveUrl("~/Pages/seller/SellerPitch.aspx") %>">Show interest &rarr;</a></div></article></section><aside id="post-request" class="h-fit rounded-2xl bg-slate-950 p-7 text-white"><h2 class="text-xl font-bold">Post your request</h2><p class="mt-3 text-sm leading-6 text-slate-300">Describe your idea and find the right person to build it.</p><a class="mt-6 block rounded-xl bg-white py-3 text-center text-sm font-semibold text-slate-950 hover:bg-blue-50" href="<%= ResolveUrl("~/Pages/public/Register.aspx") %>">Create an account</a><p class="mt-5 text-center text-xs text-slate-400">Already a member? <a class="text-white underline" href="<%= ResolveUrl("~/Pages/public/Login.aspx") %>">Sign in</a></p></aside></div></main>
</asp:Content>
