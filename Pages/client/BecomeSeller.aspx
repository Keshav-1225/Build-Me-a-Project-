<%@ Page Title="Become a Seller" Language="VB" MasterPageFile="~/Masters/Client.Master" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><main class="mx-auto w-[820px] py-12"><div class="rounded-3xl bg-slate-950 p-10 text-white"><p class="text-sm font-semibold text-blue-300">SELL ON BUILDME</p><h1 class="mt-2 text-4xl font-bold">Turn your work into opportunity.</h1><p class="mt-4 max-w-xl leading-7 text-slate-300">Create a seller profile and share projects with students, clients, and fellow developers.</p></div><div class="mt-7 rounded-2xl bg-white p-9 shadow-sm ring-1 ring-slate-200"><h2 class="text-2xl font-bold">Seller profile</h2><p class="mt-2 text-slate-600">Tell buyers a little about your experience.</p><div class="mt-7 space-y-6"><label class="block text-sm font-semibold text-slate-700">Professional headline<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="For example, Full-stack web developer" /></label><label class="block text-sm font-semibold text-slate-700">About you<textarea class="mt-2 h-32 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="Share your skills, experience, and the projects you enjoy building."></textarea></label><label class="block text-sm font-semibold text-slate-700">Primary skills<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="React, VB.NET, Python..." /></label><button class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white">Activate seller account</button></div></div></main></asp:Content>
