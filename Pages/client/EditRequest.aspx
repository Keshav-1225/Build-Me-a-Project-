<%@ Page Title="Edit Request" Language="VB" MasterPageFile="~/Masters/Client.Master" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><main class="mx-auto w-[820px] py-12"><a class="text-sm font-semibold text-blue-600" href="<%= ResolveUrl("~/Pages/client/RequestDetails.aspx?id=1") %>">&larr; Back to request</a><div class="mt-6 rounded-2xl bg-white p-9 shadow-sm ring-1 ring-slate-200"><h1 class="text-3xl font-bold">Edit request</h1><div class="mt-7 space-y-5"><label class="block text-sm font-semibold">Topic<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" value="Need an e-commerce storefront" /></label><label class="block text-sm font-semibold">Description<textarea class="mt-2 h-32 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal">Looking for a developer to turn a complete design into a storefront.</textarea></label><div class="grid grid-cols-1 gap-5 sm:grid-cols-2"><label class="text-sm font-semibold">Tech stack<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" value="React" /></label><label class="text-sm font-semibold">Budget<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" value="₹15,000" /></label><label class="text-sm font-semibold">Deadline<input type="date" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" value="2026-09-30" /></label><label class="text-sm font-semibold">Status<select class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-normal"><option selected="selected">OPEN</option><option>SELECTED</option><option>COMPLETED</option><option>EXPIRED</option></select></label></div><button class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white">Save changes</button></div></div></main></asp:Content>
