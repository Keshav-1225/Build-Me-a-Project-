<%@ Page Title="Post a Request" Language="VB" MasterPageFile="~/Masters/Site.Master" %>

<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
    <main class="mx-auto w-[820px] py-14"><div class="rounded-2xl bg-white p-10 shadow-sm ring-1 ring-slate-200"><p class="text-sm font-semibold text-blue-600">PROJECT REQUEST</p><h1 class="mt-2 text-3xl font-bold tracking-tight">Bring your idea to life</h1><p class="mt-3 text-slate-600">Share what you need and let the right developers come to you.</p><form class="mt-9 space-y-6"><label class="block text-sm font-semibold text-slate-700">Topic<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal outline-none focus:border-blue-500" type="text" placeholder="For example, build a portfolio website" /></label><label class="block text-sm font-semibold text-slate-700">Description<textarea class="mt-2 h-36 w-full resize-none rounded-xl border border-slate-300 px-4 py-3 font-normal outline-none focus:border-blue-500" placeholder="Describe your requirements, features, and any important details."></textarea></label><div class="grid grid-cols-2 gap-6"><label class="block text-sm font-semibold text-slate-700">Tech stack<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal outline-none focus:border-blue-500" type="text" placeholder="React, Python, Flutter..." /></label><label class="block text-sm font-semibold text-slate-700">Budget<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal outline-none focus:border-blue-500" type="text" placeholder="₹ 5,000" /></label></div><label class="block text-sm font-semibold text-slate-700">Preferred completion date<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal outline-none focus:border-blue-500" type="text" placeholder="For example, within 2 weeks" /></label><div class="flex items-center gap-4 border-t border-slate-100 pt-7"><button class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700" type="submit">Post request</button><a class="text-sm font-semibold text-slate-600 hover:text-slate-950" href="<%= ResolveUrl("~/Pages/client/Requests.aspx") %>">Cancel</a></div></form></div></main>
</asp:Content>
