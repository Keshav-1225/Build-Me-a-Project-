<%@ Page Title="New Announcement" Language="VB" MasterPageFile="~/Masters/Admin.Master" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><div class="mx-auto w-[760px]"><a class="text-sm font-semibold text-blue-600" href="<%= ResolveUrl("~/Pages/admin/Announcements.aspx") %>">&larr; Announcements</a><h1 class="mt-5 text-4xl font-bold">New announcement</h1><div class="mt-8 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200"><div class="space-y-6"><label class="block text-sm font-semibold">Title<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="Announcement title" /></label><label class="block text-sm font-semibold">Audience<select class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal"><option>All users</option><option>Buyers</option><option>Sellers</option><option>Selected users</option></select></label><label class="block text-sm font-semibold">Message<textarea class="mt-2 h-36 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="Write a clear message for the selected audience."></textarea></label><div class="flex gap-4"><button class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white">Send announcement</button><a class="py-3 text-sm font-semibold text-slate-600" href="<%= ResolveUrl("~/Pages/admin/Announcements.aspx") %>">Cancel</a></div></div></div></div></asp:Content>
