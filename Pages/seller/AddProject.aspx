<%@ Page Title="Add Project" Language="VB" MasterPageFile="~/Masters/Seller.Master" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><div class="mx-auto w-[760px]"><p class="text-sm font-semibold text-blue-600">NEW LISTING</p><h1 class="mt-2 text-4xl font-bold">Add a project</h1><div class="mt-8 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200"><div class="space-y-5"><label class="block text-sm font-semibold">Project title<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="Give your project a clear name" /></label><label class="block text-sm font-semibold">Description<textarea class="mt-2 h-32 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="Explain what the project does and what buyers receive."></textarea></label><div class="grid grid-cols-2 gap-5"><label class="text-sm font-semibold">Category<select class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal"><option>Choose a category</option><option>Web development</option><option>Python</option></select></label><label class="text-sm font-semibold">Price<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="₹ 499" /></label></div><label class="block text-sm font-semibold">Technology stack<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="React, Flask, VB.NET..." /></label><label class="block text-sm font-semibold">Setup instructions<textarea class="mt-2 h-28 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal" placeholder="Give buyers clear setup instructions."></textarea></label><div class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500">Upload screenshots or project preview</div><button class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white">Publish project</button></div></div></div></asp:Content>
