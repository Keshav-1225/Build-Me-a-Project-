<%@ Page Title="Submit Your Pitch" Language="VB" MasterPageFile="~/Masters/Site.Master" %>

<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
    <main class="mx-auto w-[760px] py-14"><a class="text-sm font-semibold text-blue-600" href="<%= ResolveUrl("~/Pages/client/Requests.aspx") %>">&larr; Back to requests</a><div class="mt-6 rounded-2xl bg-white p-10 shadow-sm ring-1 ring-slate-200"><p class="text-sm font-semibold text-blue-600">SELLER PITCH</p><h1 class="mt-2 text-3xl font-bold tracking-tight">Submit your pitch</h1><p class="mt-3 text-slate-600">Pitch for: <strong class="text-slate-950">Need an e-commerce storefront</strong></p><form class="mt-9 space-y-6"><label class="block text-sm font-semibold text-slate-700">Your proposed price<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal outline-none focus:border-blue-500" type="text" placeholder="₹ 15,000" /></label><label class="block text-sm font-semibold text-slate-700">Estimated completion date<input class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 font-normal outline-none focus:border-blue-500" type="text" placeholder="For example, 14 days" /></label><label class="block text-sm font-semibold text-slate-700">Your proposal<textarea class="mt-2 h-40 w-full resize-none rounded-xl border border-slate-300 px-4 py-3 font-normal outline-none focus:border-blue-500" placeholder="Explain how you will approach this project, relevant experience, and what the requester can expect."></textarea></label><button class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700" type="submit">Submit pitch</button></form></div></main>
</asp:Content>
